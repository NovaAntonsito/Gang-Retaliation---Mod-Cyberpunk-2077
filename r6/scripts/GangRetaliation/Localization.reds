        this.Text("GR-Trait-glass_jaw", "Glass jaw (weak to headshots)");
        this.Text("GR-Trait-tough", "Thick skin (takes less damage)");
        this.Text("GR-Trait-deadly", "Deadly (hits V harder)");
        this.Text("GR-TraitShort-fireproof", "Fire res.");
        this.Text("GR-TraitShort-fear_fire", "Weak: fire");
        this.Text("GR-TraitShort-insulated", "Shock res.");
        this.Text("GR-TraitShort-weak_shock", "Weak: shock");
        this.Text("GR-TraitShort-toxproof", "Toxin res.");
        this.Text("GR-TraitShort-weak_tox", "Weak: toxins");
        this.Text("GR-TraitShort-brawler", "Brawler");
        this.Text("GR-TraitShort-weak_melee", "Weak: melee");
        this.Text("GR-TraitShort-blastproof", "Blast res.");
        this.Text("GR-TraitShort-weak_blast", "Weak: blasts");
        this.Text("GR-TraitShort-firewall", "Firewall");
        this.Text("GR-TraitShort-weak_hack", "Weak: hacks");
        this.Text("GR-TraitShort-hardhead", "Hard head");
        this.Text("GR-TraitShort-glass_jaw", "Glass jaw");
        this.Text("GR-TraitShort-tough", "Thick skin");
        this.Text("GR-TraitShort-deadly", "Deadly");

        this.Text("GR-Flee-1", "This ain't over, choom! I'll be back for you!");
